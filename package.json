{
  "name": "rame-guardian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "services/*", "apps/*"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:live-repair": "tsx scripts/live-selective-repair.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:engine": "npm run typecheck && npm test",
    "check:web": "npm run check --workspace @rame/guardian-web",
    "check": "npm run check:engine && npm run check:web"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.0.17"
  }
}
